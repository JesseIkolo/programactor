# ==========================================================================
# MESURE — aucune de ces variables n'est obligatoire.
# Tant qu'une variable est absente, la brique correspondante ne fait rien et
# le site fonctionne exactement comme avant.
# Sur Netlify : Site configuration > Environment variables.
# ==========================================================================

# --------------------------------------------------------------------------
# 1. NAVIGATEUR — préfixe NEXT_PUBLIC_, donc visible côté client (normal :
#    un identifiant de pixel n'est pas un secret).
# --------------------------------------------------------------------------

# Plausible — audience + événements, sans cookie donc sans bandeau à créer.
# Valeur = le domaine tel qu'il est enregistré dans Plausible.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=programactor.pro

# Meta Pixel — Gestionnaire d'événements > Sources de données > ID à 15-16 chiffres.
NEXT_PUBLIC_META_PIXEL_ID=

# TikTok Pixel — TikTok Ads Manager > Outils > Événements > Web > ID du pixel.
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# --------------------------------------------------------------------------
# 2. SERVEUR — Conversions API (Meta) et Events API (TikTok).
#    SANS préfixe NEXT_PUBLIC_ : ces jetons ne doivent jamais partir dans le
#    navigateur. Ils rattrapent les conversions que le pixel perd (bloqueurs,
#    ATT sur iOS, cookies plafonnés sur Safari).
# --------------------------------------------------------------------------

# Meta : jeton d'UTILISATEUR SYSTÈME avec la permission ads_management sur le
# dataset (Business Manager > Paramètres de l'entreprise > Utilisateurs système).
# Pas le jeton personnel : il expire.
META_CAPI_ACCESS_TOKEN=
# L'ID du dataset = celui du pixel dans le Gestionnaire d'événements.
META_CAPI_DATASET_ID=
# Optionnel : version de l'API Graph. Défaut v25.0.
META_GRAPH_API_VERSION=

# TikTok : jeton d'Events API, généré dans les paramètres du pixel.
TIKTOK_EVENTS_API_TOKEN=
TIKTOK_PIXEL_ID=
# Optionnel : version de l'API. Défaut v1.3.
TIKTOK_API_VERSION=

# --------------------------------------------------------------------------
# 3. VÉRIFICATION AVANT MISE EN PRODUCTION
#    Renseigner un code de test fait apparaître les événements dans l'onglet
#    « Test Events » de la régie, sans polluer les vraies statistiques.
#    C'est là qu'on vérifie que la déduplication fonctionne : un seul
#    événement doit apparaître, marqué comme reçu par les DEUX canaux.
#    ⚠ Vider ces deux variables une fois la vérification faite.
# --------------------------------------------------------------------------
META_CAPI_TEST_EVENT_CODE=
TIKTOK_TEST_EVENT_CODE=

# --------------------------------------------------------------------------
# 4. NORMALISATION DES TÉLÉPHONES
#    Indicatif préfixé quand le prospect saisit un numéro national
#    (8 ou 9 chiffres). Défaut 237 (Cameroun) ; mettre 241 pour le Gabon si
#    l'essentiel du trafic vient de Libreville.
# --------------------------------------------------------------------------
DEFAULT_PHONE_COUNTRY_CODE=237
