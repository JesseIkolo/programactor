# =============================================================================
# VARIABLES D'ENVIRONNEMENT — PROGRAMACTOR BACKEND
# =============================================================================

NODE_ENV=production
PORT=5000

# Base de Données MongoDB (Local ou MongoDB Atlas)
# En local Docker : mongodb://mongodb:27017/programactor
# Sur VPS direct : mongodb://127.0.0.1:27017/programactor
# Sur MongoDB Atlas : mongodb+srv://<user>:<password>@cluster0.mongodb.net/programactor?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/programactor

# Clés secrètes JWT (minimum 64 caractères aléatoires)
JWT_SECRET=votre_cle_secrete_jwt_robuste_et_longue_a_generer_pour_la_production_12345
JWT_REFRESH_SECRET=autre_cle_secrete_pour_le_refresh_token_a_generer_avec_openssl_rand_64
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Domaines Frontend autorisés par CORS (séparés par des virgules)
ALLOWED_ORIGINS=https://www.programactor.pro,https://programactor.pro,http://localhost:3000

# Notifications Studio
RESEND_API_KEY=re_votre_cle_resend
NOTIFICATION_EMAIL=hello@programactor.pro
STUDIO_WHATSAPP_NUMBER=237699000000

# Premier Administrateur (Initialisation / Seed automatique au premier lancement)
INITIAL_ADMIN_EMAIL=admin@programactor.pro
INITIAL_ADMIN_PASSWORD=ChangeMeNow12345!
INITIAL_ADMIN_NAME=Jesse Ikolo
